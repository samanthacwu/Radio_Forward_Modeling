lines.linewidth : 2
lines.markersize : 10
# figure.titlesize : 30
# axes.titlesize : 20 
# axes.labelsize : 20  
axes.xmargin : 0  
axes.ymargin : 0.01  
axes.linewidth : 1.0
axes.spines.top : True  
axes.spines.right : True
grid.color : black  
grid.linestyle : --  
grid.linewidth : 1  
grid.alpha : 0.4
# xtick.labelsize : 20
xtick.major.size : 8  
xtick.major.width : 1.5
xtick.minor.size : 4  
xtick.direction : in
# ytick.labelsize : 20
ytick.major.size : 8
ytick.major.width : 1.5
ytick.minor.size : 4
ytick.direction : in
# legend.fontsize : 16
legend.framealpha : 0.4
font.family : STIXGeneral
mathtext.fontset : stix
font.size: 12.0
figure.dpi: 80
figure.figsize: 8,6
